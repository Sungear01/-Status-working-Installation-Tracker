APP_NAME="ระบบติดตามสถานะงานติดตั้งลูกค้า"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/cap-plus/public
APP_TIMEZONE=Asia/Bangkok
SESSION_NAME=cap_plus_session

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cap_plus
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Existing customer table (read-only by default)
CUSTOMER_TABLE=customers
CUSTOMER_WRITES_ENABLED=false

# SMTP mail (leave disabled until valid credentials are supplied)
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Status working Installation Tracker"

# Keep test mode until delivery is verified, then change to user.
MAIL_PASSWORD_RESET_MODE=test
MAIL_TEST_RECIPIENT=Dnaigook@gmail.com
MAIL_PASSWORD_RESET_ADMIN_RECIPIENT=
MAIL_ADMIN_RECIPIENTS=
