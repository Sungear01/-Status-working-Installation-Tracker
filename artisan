#!/usr/bin/env php
<?php

declare(strict_types=1);

// Compatibility launcher for this plain-PHP MVC project.
// It intentionally supports only `php artisan serve`; this is not Laravel Artisan.
if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "The artisan launcher can only run from CLI.\n");
    exit(1);
}

$arguments = array_slice($argv, 1);
if (($arguments[0] ?? '') !== 'serve') {
    fwrite(STDERR, "Supported command: php artisan serve [--host=127.0.0.1] [--port=8000]\n");
    exit(1);
}

$host = '127.0.0.1';
$port = 8000;
for ($i = 1, $count = count($arguments); $i < $count; $i++) {
    $argument = $arguments[$i];
    if (str_starts_with($argument, '--host=')) {
        $host = substr($argument, 7);
    } elseif ($argument === '--host') {
        $host = $arguments[++$i] ?? $host;
    } elseif (str_starts_with($argument, '--port=')) {
        $port = (int) substr($argument, 7);
    } elseif ($argument === '--port') {
        $port = (int) ($arguments[++$i] ?? $port);
    }
}

if (!filter_var($host, FILTER_VALIDATE_IP) && $host !== 'localhost') {
    fwrite(STDERR, "Invalid host.\n");
    exit(1);
}
if ($port < 1 || $port > 65535) {
    fwrite(STDERR, "Invalid port.\n");
    exit(1);
}

$public = dirname(__FILE__) . DIRECTORY_SEPARATOR . 'public';
$command = sprintf('"%s" -S %s:%d -t "%s"', PHP_BINARY, $host, $port, $public);
fwrite(STDOUT, "PHP development server: http://{$host}:{$port}\n");
passthru($command, $exitCode);
exit($exitCode);

